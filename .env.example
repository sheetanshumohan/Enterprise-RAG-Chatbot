# ==============================================================================
# Enterprise AI Knowledge Assistant - Environment Configuration
# ==============================================================================

# --- Environment & Security ---
ENVIRONMENT=production                       # "development" | "staging" | "production"
JWT_SECRET=change-me-to-a-64-character-random-hex-string-for-production
CORS_ORIGINS=https://app.yourdomain.com,http://localhost:8501

# --- Managed Postgres (Neon Serverless Postgres) ---
# Neon connection string (pooled or unpooled, with ssl=require / sslmode=require)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require

# --- Managed Redis (Upstash Redis) ---
# Upstash TLS connection strings with rediss://
REDIS_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379/0
CELERY_BROKER_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379/1
CELERY_RESULT_BACKEND=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379/2

# --- Managed Vector Store (Qdrant Cloud) ---
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# --- OpenSearch / Elasticsearch (Lexical BM25 Search) ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=knowledge_chunks

# --- Observability: Sentry (Error Tracking & APM) ---
SENTRY_DSN=https://your-sentry-key@o0000.ingest.sentry.io/0000000
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- Observability: Prometheus (Metrics & /metrics endpoint) ---
PROMETHEUS_ENABLED=true

# --- Observability: LangSmith (LLM / RAG Tracing) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key
LANGCHAIN_PROJECT=ai-knowledge-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Embeddings (OpenAI / Azure) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- LLM Provider ("claude" | "openai" | "gemini") ---
LLM_PROVIDER=claude
LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6                # optional override

# --- Vector Store & OpenSearch Additional Settings ---
QDRANT_COLLECTION=knowledge_assistant_chunks
QDRANT_TIMEOUT=30.0
OPENSEARCH_TIMEOUT=30.0
OPENSEARCH_MAX_RETRIES=3

# --- Reranking & Retrieval Settings ---
USE_CROSS_ENCODER_RERANKER=false             # true requires downloading sentence-transformers weights
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RATE_LIMIT_PER_MINUTE=60                     # Distributed rate limit per IP across all instances
MAX_UPLOAD_MB=25                             # Max file size per upload in MB

# --- Chunking Parameters ---
CHUNK_PARENT_MAX_TOKENS=1500
CHUNK_CHILD_MAX_TOKENS=300
CHUNK_OVERLAP_UNITS=1

# --- Agentic RAG Pipeline Parameters ---
RAG_MAX_RETRIEVAL_ITERATIONS=3
RAG_TOKEN_BUDGET=4000
RAG_TOP_K_VECTOR=20
RAG_TOP_K_BM25=20
RAG_TOP_K_FUSED=10
RAG_RRF_K=60
RAG_MAX_GENERATION_TOKENS=1024
RAG_PLANNER_MAX_TOKENS=300
RAG_EVALUATOR_MAX_TOKENS=300
RAG_FOLLOWUP_MAX_TOKENS=200
RAG_HISTORY_MESSAGES_LIMIT=6

# --- Database Pool & Celery Settings ---
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=480


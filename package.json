{
  "name": "knowledge-assistant",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:backend": "turbo run dev --filter=backend",
    "dev:frontend": "turbo run dev --filter=frontend",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "docker": "docker compose up --build"
  },
  "devDependencies": {
    "turbo": "^2.1.3"
  },
  "packageManager": "pnpm@9.12.0"
}
